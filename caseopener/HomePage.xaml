<Page x:Class="caseopener.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:caseopener"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <StackPanel>
            <TextBlock 
                x:Name="txtTitle"
                Text="Case Opener" 
                FontSize="24" 
                FontWeight="Bold" 
                Margin="10" 
    />
            <Image 
                x:Name="imgLogo"
                Source="/resources/weaponcase.png" 
                Width="200" 
                Height="200" 
                Margin="10"
                Stretch="Uniform"
    />

            <Button
                Content="Otwórz Skrzynkę"
                Width="150"
                Height="40"
                Margin="10"
                Click="OpenCase_Click"
        />

        </StackPanel>
    </Grid>
</Page>
