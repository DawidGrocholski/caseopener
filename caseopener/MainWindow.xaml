<Window x:Class="caseopener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:caseopener"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock 
                x:Name="txtTitle"
                Text="Case Opener" 
                FontSize="24" 
                FontWeight="Bold" 
                Margin="10" 
            />
            <Image 
                x:Name="imgLogo"
                Source="/resources/weaponcase.png" 
                Width="200" 
                Height="200" 
                Margin="10"
                Stretch="Uniform"
            />
            <Button 
                Content="Open Case" 
                Width="100" 
                Height="30" 
                Margin="10" 
                Click="OpenCase_Click"
            />
        </StackPanel>
    </Grid>
</Window>
